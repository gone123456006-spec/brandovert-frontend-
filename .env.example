# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables.

# Brandovert API (the backend on Render), e.g. https://brandovert-api.onrender.com
BACKEND_URL=http://localhost:4000
# Must equal INTERNAL_API_KEY on the backend.
BACKEND_API_KEY=

# Public site address, used for SEO metadata and the sitemap.
# Optional: production builds default to https://brandovert.com.
NEXT_PUBLIC_SITE_URL=https://brandovert.com

# Optional backup: also POST each enquiry to this webhook (Zapier, Make, Slack...).
CONTACT_WEBHOOK_URL=
